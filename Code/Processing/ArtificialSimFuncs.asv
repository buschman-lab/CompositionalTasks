classdef ArtificialSimFuncs
    %ARTIFICIALSIMFUNCS summery of functions to generate artifical data and
    %build neural networks
    properties
        % properties for simulating leaky intergrate and fire network using
        % SimLIFNet
        W=0; % weight propeties.
        simTime=''  % The amount of simulated time(sec) over which to integrate the model,
        
        tstep=0.001 % Simulated time step-size.  (1 ms resolution)
        initialConditions=''    % An Nx1 vector specifying the initial membrane voltage
        %   of each neuron 
        refractoryTime =0   %An Nx1 vector specifying the refractory period of each
        %   neuron 
        offsetCurrents=''   % An Nx1 vector specifying a constant bias current to be
        %   injected continuously into each cell. {0}
        synapticDensity=''  % An NxN matrix specifying the density of the synaptic
        %   connection 
        forcingFunctions='' % An Xx2 cell array with the first column being an array
        %   of function handles specifying an arbitrary time-varying forcing
        %   function of the neuron where the second column contains a scalar
        %   indicating the neuron to which the forcing is applied.
        noiseAmplitude='' % An Nx1 array specifying the amplitude of a zero-mean
        %   gaussian noise source of current added to the corrisponding neuron,
        
        plotResults=0 % Display a plot of simulation results. [0 {1}] 
        
        ForcingFuncSet={'heaviside','sin'} % set of functions for forrcing input
      
    end

    properties (Access=private)
        ManData=ManipulateData;
        TrialFunc=TrialFuncs;
        FigParams=fig_params;
    end
    methods
        function  obj=ArtificialSimFuncs(varargin)
            if nargin~=0 % initialize vars
                obj=obj.ParseParams(varargin) ; %%Process optional inputs
            end
        end
        function  obj=ParseParams(obj,InputArgs)
            %Process optional inputs
            if mod(length(InputArgs), 2) ~= 0, error('Must pass key/value pairs for options.'); end
            for i = 1:2:length(InputArgs)
                try
                    obj.(InputArgs{i}) = InputArgs{i+1};
                catch
                    error('Couldn''t set option ''%s''.', InputArgs{2*i-1});
                end
            end
        end

        function  [spk,NetParams,V]=GenerateFakeNeuronWithFactors(obj,FactorizedData,SensitiveFactors,varargin) % generates fake data based on the factors that are given in the data
            global AnalysisOpts
            obj=obj.ParseParams(varargin) ; %%Process optional inputs
           
            NNeu=length(FactorizedData);
            Ntrl=size(FactorizedData.data,1);
            obj=obj.GenerateOptsSimLIFNet(NNeu); % geenrate default parameters
            % loop on trials
            for TrlNum=1:Ntrl
                fprintf('Simulating Fake Neuron Trial %i\n',TrlNum)
                % prepare our input
                Ffcninput=obj.GetFactorForcingFuncOptions(SensitiveFactors,FactorizedData,TrlNum);
                % generate forcing function 
                obj.forcingFunctions=obj.GenerateForcingFunction(Ffcninput);
                % simulate the network
                [spk{TrlNum},NetParams{TrlNum},V{TrlNum}] = SimLIFNet(obj.W,'simTime',obj.simTime,'tstep',obj.tstep,'initialConditions',obj.initialConditions,...
                    'offsetCurrents',obj.offsetCurrents,'refractoryTime',obj.refractoryTime,'noiseAmplitude',obj.noiseAmplitude,...
                    'plotResults',obj.plotResults,'forcingFunctions',obj.forcingFunctions);
            end
            
        end
        function Ffcns=GenerateForcingFunction(obj,InputTiming,varargin)
            % generates forcing function accorfing to InputTimaing matrix
            % input timing matrix is denoting the start time(sec) and end time and amplitude of the input for the neuron 
            % for example {[0.5 1 1 1;1.5 2 5 1] [0.5 1 1 2;1.5 2 5 2]}
            % {[StrTim StpTim Amp Function]}, each is timing for a neuron
            %    exampe output Ffcns = {@(t) 1.5*heaviside(t-10), 1; @sin, 2};

            global AnalysisOpts
            obj=obj.ParseParams(varargin) ; %%Process optional inputs

            NNeu=length(InputTiming);
            % create forcing function test for one neuron 
            PasteFunc=@(StrTim,StpTim,Amp,ffname) sprintf('%i*(%s(t-%i)-%s(t-%i))',Amp,ffname,StrTim,ffname,StpTim);
            ForceFuncTxt=(@(input,ForcingFuncSet) cell2mat(arrayfun(@(x) [ PasteFunc(input(x,1),input(x,2),input(x,3),ForcingFuncSet{input(x,4)})...
                obj.AddPlus(x,size(input,1))],1:size(input,1),'UniformOutput',0)));
           
            % loop through all of the neurons to create final product 
            temp = [];
            for i = 1:NNeu
                if i~=NNeu
                    temp = [temp '@(t) ' ForceFuncTxt(InputTiming{i},obj.ForcingFuncSet) ', ' num2str(i) ';'];
                else %final round, no ;
                    temp = [temp '@(t) ' ForceFuncTxt(InputTiming{i},obj.ForcingFuncSet) ', ' num2str(i)  ];
                end
            end
            Ffcnstxt=sprintf('Ffcns ={%s};',temp);
            eval(Ffcnstxt);
         
        end
        function Ffcninput=GetFactorForcingFuncOptions(obj,SensitiveFactors,FactorizedData,TrlNum,varargin)
            % define forcing fucntion options for each factor and
            % generate a set of them for sensitive factors 
            global AnalysisOpts
            obj=obj.ParseParams(varargin) ; %%Process optional inputs
            
            % get the necessary infor,ation 
            TimingTaskData=FactorizedData.TimingTaskData;
            StimOnsetTime=TimingTaskData(TrlNum,AnalysisOpts.SampleTimInd);
            RewardOnsetTime=TimingTaskData(TrlNum,AnalysisOpts.RewardTimInd);
            BuildFfcninput=@(FfcnOpts,FactorName) [FfcnOpts.(FactorName).StrTim+rand*FfcnOpts.(FactorName).StrTimJit FfcnOpts.(FactorName).StrTim+FfcnOpts.(FactorName).Duration FfcnOpts.(FactorName).Amp 1 ];
            % loop on the sensitive factors now
            for nSF=1:length(SensitiveFactors)
                FactorName=SensitiveFactors{nSF};
                factorind=strcmp(AnalysisOpts.factornames,FactorName);
                factorval=FactorizedData.factors{factorind}(TrlNum);
                FfcnOpts=obj.DefineFactorForcingFuncOptions(FactorName,factorval,StimOnsetTime,RewardOnsetTime);
                Ffcninput{1}(nSF,:)=BuildFfcninput(FfcnOpts,FactorName);
            end

        end
        function FfcnOpts=DefineFactorForcingFuncOptions(obj,FactorName,factorval,StimOnsetTime,RewardOnsetTime) % defines the options for forcing functions
            BaseAmp=100;
            switch FactorName
                case 'ColorML'
                    FfcnOpts.(FactorName).FactorTuning=pi; % what is the tuning for this cell
                    FfcnOpts.(FactorName).StrTimJit=0.1; % jitter we have for the start of the stimlus
                    FfcnOpts.(FactorName).StrTim=StimOnsetTime; % start with sample time
                    FfcnOpts.(FactorName).Duration=0.2; % 200ms presentation
                    FfcnOpts.(FactorName).Amp=BaseAmp*cos(obj.ManData.ConvertML2rad(factorval)-FfcnOpts.(FactorName).FactorTuning);
                case 'ShapeML'
                    FfcnOpts.(FactorName).FactorTuning=0; % what is the tuning for this cell
                    FfcnOpts.(FactorName).StrTimJit=0.1; % jitter we have for the start of the stimlus
                    FfcnOpts.(FactorName).StrTim=StimOnsetTime; % start with sample time
                    FfcnOpts.(FactorName).Duration=0.2; % 200ms presentation
                    FfcnOpts.(FactorName).Amp=BaseAmp*cos(obj.ManData.ConvertML2rad(factorval)-FfcnOpts.(FactorName).FactorTuning);
                case 'ColorCat'
                    FfcnOpts.(FactorName).FactorTuning=[-1 0;1 0;2 1]; % wieght for categories [-1 1 2] values
                    FfcnOpts.(FactorName).StrTimJit=0.1; % jitter we have for the start of the stimlus
                    FfcnOpts.(FactorName).StrTim=StimOnsetTime; % start with sample time
                    FfcnOpts.(FactorName).Duration=0.2; % 200ms presentation
                    FfcnOpts.(FactorName).Amp=BaseAmp*FfcnOpts.(FactorName).FactorTuning(factorval==FfcnOpts.(FactorName).FactorTuning(:,1),2);
                case 'ShapeCat'
                    FfcnOpts.(FactorName).FactorTuning=[-1 0;1 1;2 0]; % wieght for categories [-1 1 2] values
                    FfcnOpts.(FactorName).StrTimJit=0.1; % jitter we have for the start of the stimlus
                    FfcnOpts.(FactorName).StrTim=StimOnsetTime; % start with sample time
                    FfcnOpts.(FactorName).Duration=0.2; % 200ms presentation
                    FfcnOpts.(FactorName).Amp=BaseAmp*FfcnOpts.(FactorName).FactorTuning(factorval==FfcnOpts.(FactorName).FactorTuning(:,1),2);
                case 'Rule'
                    FfcnOpts.(FactorName).FactorTuning=[1 1;2 2;3 3]; % wieght for rules [1 2 3] values
                    FfcnOpts.(FactorName).StrTimJit=0.1; % jitter we have for the start of the stimlus
                    FfcnOpts.(FactorName).StrTim=StimOnsetTime-0.2; % start 200 ms before sample
                    FfcnOpts.(FactorName).Duration=0.2; % 200ms presentation
                    FfcnOpts.(FactorName).Amp=BaseAmp*FfcnOpts.(FactorName).FactorTuning(factorval==FfcnOpts.(FactorName).FactorTuning(:,1),2);
                case 'Feature'
                    FfcnOpts.(FactorName).FactorTuning=[1 1;2 2]; % wieght for feature [1 2] values
                    FfcnOpts.(FactorName).StrTimJit=0.1; % jitter we have for the start of the stimlus
                    FfcnOpts.(FactorName).StrTim=StimOnsetTime-0.2; % start 200 ms before sample
                    FfcnOpts.(FactorName).Duration=0.2; % 200ms presentation
                    FfcnOpts.(FactorName).Amp=BaseAmp*FfcnOpts.(FactorName).FactorTuning(factorval==FfcnOpts.(FactorName).FactorTuning(:,1),2);
                case 'Axis'
                    FfcnOpts.(FactorName).FactorTuning=[1 1;2 2]; % wieght for axis [1 2] values
                    FfcnOpts.(FactorName).StrTimJit=0.1; % jitter we have for the start of the stimlus
                    FfcnOpts.(FactorName).StrTim=StimOnsetTime-0.2; % start 200 ms before sample
                    FfcnOpts.(FactorName).Duration=0.2; % 200ms presentation
                    FfcnOpts.(FactorName).Amp=BaseAmp*FfcnOpts.(FactorName).FactorTuning(factorval==FfcnOpts.(FactorName).FactorTuning(:,1),2);
                case 'ResponseLoc'
                    FfcnOpts.(FactorName).FactorTuning=[1 1;2 1;3 0;4 0]; % wieght for response loc [1 2 3 4] values
                    FfcnOpts.(FactorName).StrTimJit=0.1; % jitter we have for the start of the stimlus
                    FfcnOpts.(FactorName).StrTim=RewardOnsetTime-0.2; % start 200 ms before sample
                    FfcnOpts.(FactorName).Duration=0.2; % 200ms presentation
                    FfcnOpts.(FactorName).Amp=BaseAmp*FfcnOpts.(FactorName).FactorTuning(factorval==FfcnOpts.(FactorName).FactorTuning(:,1),2);

            end
        end
        function obj=GenerateOptsSimLIFNet(obj,NNeu) % generate default options for SimLIFNet
            I=@(y,x) rand(y,x);            
            obj.simTime=5;
            obj.W= 1*I(NNeu,NNeu)-0.5;
            obj.offsetCurrents=1.1*I(1,NNeu);
            obj.synapticDensity=3*I(NNeu,NNeu);
            obj.initialConditions=0.4*I(NNeu,NNeu);
            obj.refractoryTime=0*I(1,NNeu);
            obj.noiseAmplitude=0.3*I(1,NNeu);
        end
        function out=AddPlus(~,x,xend)
            if x~=xend;out='+';else; out='';end
        end
        
    end

end

